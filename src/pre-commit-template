#!/usr/bin/env python3

# -------------------------------------------------------------------------------- #
# Description                                                                      #
# -------------------------------------------------------------------------------- #
# Self-contained Git pre-commit hook template. Copy this file into                 #
# hooks/pre-commit/<name> and edit the header only.                                #
# -------------------------------------------------------------------------------- #

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
from collections.abc import Callable
from typing import TextIO

__version__ = "0.1.1"

# -------------------------------------------------------------------------------- #
# Config (edit this)                                                               #
# -------------------------------------------------------------------------------- #

REQUIRED_COMMANDS: list[str] = []
TOOL: list[str] | None = None
FILE_EXTENSIONS: list[str] = []
SHEBANG_PATTERN: str | None = None
RUN_MODE: str = "batch"

UPFRONT_PROMPT: str | None = None
UPFRONT_WHEN: Callable[[], bool] | None = None
CONFIRM_FINDINGS_PROMPT: str | None = None

ON_MISSING_TOOL: str = "abort"
ON_NO_TTY_UPFRONT: str = "abort"
ON_NO_TTY_FINDINGS: str = "abort"

match_file: Callable[[str], bool] | None = None
run_check: Callable[[list[str]], int] | None = None
should_upfront_prompt: Callable[[], bool] | None = None

# -------------------------------------------------------------------------------- #
# STOP HERE                                                                        #
# -------------------------------------------------------------------------------- #
# The functions below are the engine. Do not edit them to make a new hook.         #
# -------------------------------------------------------------------------------- #


def current_branch() -> str:
    git_path = resolve_git()
    process = subprocess.run(
        [git_path, "symbolic-ref", "--short", "HEAD"],
        check=False,
        capture_output=True,
        text=True,
    )
    name = process.stdout.strip()
    if process.returncode != 0 or not name:
        print(process.stderr.strip() or "Failed to read current branch.", file=sys.stderr)
        sys.exit(1)
    return name


def validate_knobs() -> None:
    if RUN_MODE not in {"batch", "each"}:
        print(f"Unknown RUN_MODE: {RUN_MODE}", file=sys.stderr)
        sys.exit(1)
    for name, value in (
        ("ON_MISSING_TOOL", ON_MISSING_TOOL),
        ("ON_NO_TTY_UPFRONT", ON_NO_TTY_UPFRONT),
        ("ON_NO_TTY_FINDINGS", ON_NO_TTY_FINDINGS),
    ):
        if value not in {"abort", "skip"}:
            print(f"Unknown {name}: {value}", file=sys.stderr)
            sys.exit(1)


def resolve_git() -> str:
    path = shutil.which("git")
    if path is None:
        print("git is not installed - Aborting", file=sys.stderr)
        sys.exit(1)
    return path


def resolve_required_commands() -> dict[str, str]:
    missing: list[str] = []
    found: dict[str, str] = {}
    for command in REQUIRED_COMMANDS:
        path = shutil.which(command)
        if path is None:
            missing.append(command)
        else:
            found[command] = path
    if missing:
        for name in missing:
            print(f"{name} is not installed - Aborting", file=sys.stderr)
        if ON_MISSING_TOOL == "skip":
            raise SystemExit(0)
        if ON_MISSING_TOOL != "abort":
            print(f"Unknown ON_MISSING_TOOL: {ON_MISSING_TOOL}", file=sys.stderr)
        raise SystemExit(1)
    return found


def find_repo_root(git_path: str) -> str:
    process = subprocess.run(
        [git_path, "rev-parse", "--show-toplevel"],
        check=False,
        capture_output=True,
        text=True,
    )
    root = process.stdout.strip()
    if process.returncode != 0 or not root or not os.path.isdir(root):
        detail = process.stderr.strip()
        print(detail or "No git working tree found.", file=sys.stderr)
        sys.exit(1)
    return root


def list_staged_files(git_path: str) -> list[str]:
    os.chdir(find_repo_root(git_path))
    process = subprocess.run(
        [git_path, "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        check=False,
        capture_output=True,
        text=True,
    )
    if process.returncode != 0:
        print(process.stderr.strip() or "Failed to list staged files.", file=sys.stderr)
        sys.exit(1)
    return [line for line in process.stdout.splitlines() if line]


def shebang_matches(path: str, pattern: str) -> bool:
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            first = handle.readline()
    except OSError:
        return False
    return re.search(pattern, first) is not None


def file_matches(path: str) -> bool:
    extensions = list(FILE_EXTENSIONS)
    shebang = SHEBANG_PATTERN
    if not extensions and not shebang:
        return True
    if extensions and any(path.endswith(ext) for ext in extensions):
        return True
    return bool(shebang and shebang_matches(path, shebang))


def filter_staged_files(paths: list[str]) -> list[str]:
    kept: list[str] = []
    for path in paths:
        if not os.path.isfile(path) or not os.access(path, os.R_OK):
            continue
        if not file_matches(path):
            continue
        if match_file is not None and not match_file(path):
            continue
        kept.append(path)
    return kept


def open_tty() -> TextIO | None:
    try:
        return open("/dev/tty", "r+", encoding="utf-8")
    except OSError:
        return None


def prompt_yes_no(message: str, tty: TextIO) -> bool:
    while True:
        tty.write(message)
        tty.flush()
        answer = tty.readline().strip().lower()
        if answer in {"y", "yes"}:
            return True
        if answer in {"n", "no"} or answer == "":
            return False


def apply_no_tty_policy(policy: str) -> bool:
    if policy == "skip":
        return True
    print("No TTY available for prompt - Aborting", file=sys.stderr)
    sys.exit(1)


def should_ask_upfront() -> bool:
    if not UPFRONT_PROMPT:
        return False
    if should_upfront_prompt is not None:
        return bool(should_upfront_prompt())
    if UPFRONT_WHEN is not None:
        return bool(UPFRONT_WHEN())
    return True


def run_tool(files: list[str]) -> int:
    if run_check is not None:
        return run_check(files)
    if not TOOL:
        return 0
    if RUN_MODE == "batch":
        process = subprocess.run(list(TOOL) + files, check=False)
        return int(process.returncode)
    first_error = 0
    for path in files:
        process = subprocess.run(list(TOOL) + [path], check=False)
        if process.returncode != 0 and first_error == 0:
            first_error = int(process.returncode)
    return first_error


def main() -> int:
    validate_knobs()
    git_path = resolve_git()
    resolve_required_commands()
    os.chdir(find_repo_root(git_path))
    if should_ask_upfront():
        tty = open_tty()
        if tty is None:
            apply_no_tty_policy(ON_NO_TTY_UPFRONT)
        else:
            with tty:
                if not prompt_yes_no(UPFRONT_PROMPT or "", tty):
                    return 1
    if (TOOL is None or TOOL == []) and run_check is None:
        return 0
    files = filter_staged_files(list_staged_files(resolve_git()))
    if not files:
        return 0
    code = run_tool(files)
    if code == 0:
        return 0
    if CONFIRM_FINDINGS_PROMPT:
        tty = open_tty()
        if tty is None:
            apply_no_tty_policy(ON_NO_TTY_FINDINGS)
            return 0
        with tty:
            if prompt_yes_no(CONFIRM_FINDINGS_PROMPT, tty):
                return 0
        return code if code else 1
    return code if code else 1


if __name__ == "__main__":
    sys.exit(main())
